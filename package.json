{
  "name": "careroute",
  "version": "0.1.0",
  "private": true,
  "description": "CareRoute – AI care-navigation agent for people in Canada without (accessible) family doctors. Prototype: AB + BC.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "refresh:er-waits": "NODE_USE_ENV_PROXY=1 tsx scripts/refresh-er-waits.ts",
    "build:facilities": "NODE_USE_ENV_PROXY=1 tsx scripts/build-facilities.ts",
    "fetch:osm": "bash scripts/fetch-osm.sh .osm-cache"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
