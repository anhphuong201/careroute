# AI provider. OpenAI is used if OPENAI_API_KEY is set; Claude if ANTHROPIC_API_KEY is set.
# Force one with LLM_PROVIDER=openai or LLM_PROVIDER=anthropic.
# Set these in Vercel → Project → Settings → Environment Variables (never commit real keys).

OPENAI_API_KEY=
# Any chat model on your account that supports function calling
OPENAI_MODEL=gpt-5.5

# Optional alternative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# One-tap booking demo (see docs/booking-demo-setup.md)
# Google Calendar: OAuth client ID (Web application). Public by design – it is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Cal.com demo clinic (server only – keep secret). Without these the demo runs offline with made-up times.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
